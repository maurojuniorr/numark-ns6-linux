# Numark NS6 — udev rules
# Permite ao grupo plugdev abrir somente a NS6 sem root
# Instalar em: /etc/udev/rules.d/99-ns6.rules
# Recarregar: sudo udevadm control --reload && sudo udevadm trigger

SUBSYSTEM=="usb", ATTRS{idVendor}=="15e4", ATTRS{idProduct}=="0079", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Grant the active desktop user access to ALSA Sequencer for the user service.
KERNEL=="seq", SUBSYSTEM=="sound", TAG+="uaccess"
